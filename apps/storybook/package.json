{
  "name": "@catylast/storybook",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "storybook build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:install": "playwright install chromium"
  },
  "dependencies": {
    "@catylast/card": "workspace:*",
    "@catylast/dynamic-table": "workspace:*",
    "@catylast/icons": "workspace:*",
    "@catylast/primitives": "workspace:*",
    "@catylast/rich-editor": "workspace:*",
    "@catylast/theme": "workspace:*",
    "@catylast/tokens": "workspace:*",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.0.0",
    "@storybook/addon-docs": "^10.0.0",
    "@storybook/react-vite": "^10.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@playwright/test": "^1.59.0",
    "@vanilla-extract/vite-plugin": "^5.0.0",
    "http-server": "^14.1.1",
    "storybook": "^10.0.0",
    "vite": "^6.0.0"
  }
}
